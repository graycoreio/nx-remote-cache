{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [],
    "rust": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      { "runtime": "rustc --version" }
    ],
    "terraform": ["{projectRoot}/**/*.tf", { "runtime": "terraform version" }]
  },
  "targetDefaults": {
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "validate": {
      "cache": true
    }
  },
  "tui": {
    "enabled": false
  }
}

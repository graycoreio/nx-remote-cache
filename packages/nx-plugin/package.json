{
  "name": "@graycore/nx-remote-cache",
  "version": "0.4.2",
  "description": "Nx plugin that runs nx-remote-cache next to Nx, so builds use a self-hosted remote cache on Azure Blob Storage with no setup.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graycoreio/nx-remote-cache.git",
    "directory": "packages/nx-plugin"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nx-remote-cache": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "nx": ">=20.8"
  },
  "peerDependenciesMeta": {
    "nx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  }
}
